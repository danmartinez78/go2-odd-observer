# Data directories (organized structure)
# Raw inputs (large binary files)
data/raw_rosbags/**
!data/raw_rosbags/.gitkeep

# Processed outputs (regenerable)
data/processed/runs/**
!data/processed/runs/.gitkeep
!data/processed/manifest.csv

# Development artifacts (temporary)
data/development/**
!data/development/.gitkeep

# Test data (keep fixtures, ignore generated)
data/test/images/*.png
data/test/images/*.jpg
!data/test/unit_test_data/**

# Examples (keep organized, ignore temp)
data/examples/**
!data/examples/.gitkeep

# ROS bags (large binary files)
*.db3
*.mcap
*.bag
*.bag.active

# Processed data files (can be regenerated)
*.json
!tests/evaluation/perception/*.json
!tests/evaluation/motion/*.json
!tests/evaluation/odd_spec/*.json
!tests/evaluation/collision/*.json
!tests/evaluation/evaluator/*.json
!tests/evaluation/report/*.json
!tests/evaluation/fixtures/**.json
*.png
*.csv
# But allow CSV files in root and tests
!*.csv
!tests/**/*.csv
!scripts/**/*.csv
# Re-exclude data CSVs specifically
data/**/*.csv
!data/processed/manifest.csv
# Allow JSON results in docs/reports for GitHub Pages
!docs/reports/*.json

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
toy_test_results*.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
.env
go2_ros2_sdk/
